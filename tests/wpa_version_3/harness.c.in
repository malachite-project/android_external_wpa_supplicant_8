    return drv->sae_password_supported;
}

static unsigned int compute_ver(struct drv_stub *drv, struct params_stub *params)
{
    enum nl80211_wpa_versions ver = 0;

    (void) drv;

@BLOCK@

    return (unsigned int) ver;
}

struct tcase { const char *name; unsigned int proto; int akm; int sae_pw; unsigned int want; };

int main(void)
{
#if defined(CONFIG_DISABLE_WPA_VERSION_3)
    const char *mode = "opt-in ENABLED ";
#else
    const char *mode = "opt-in disabled";
#endif
    struct tcase cases[] = {
#if defined(CONFIG_DISABLE_WPA_VERSION_3)
        { "RSN + SAE, SAE_PASSWORD supported", WPA_PROTO_RSN, WPA_KEY_MGMT_SAE, 1, 2 },
        { "RSN + FT-SAE", WPA_PROTO_RSN, WPA_KEY_MGMT_FT_SAE, 1, 2 },
        { "WPA+RSN + SAE", WPA_PROTO_WPA | WPA_PROTO_RSN, WPA_KEY_MGMT_SAE, 1, 3 },
#else
        { "RSN + SAE, SAE_PASSWORD supported", WPA_PROTO_RSN, WPA_KEY_MGMT_SAE, 1, 4 },
        { "RSN + FT-SAE", WPA_PROTO_RSN, WPA_KEY_MGMT_FT_SAE, 1, 4 },
        { "WPA+RSN + SAE", WPA_PROTO_WPA | WPA_PROTO_RSN, WPA_KEY_MGMT_SAE, 1, 5 },
#endif
        { "RSN + SAE, no SAE_PASSWORD attr", WPA_PROTO_RSN, WPA_KEY_MGMT_SAE, 0, 2 },
        { "RSN + PSK (WPA2)", WPA_PROTO_RSN, WPA_KEY_MGMT_PSK, 1, 2 },
        { "WPA1 + PSK", WPA_PROTO_WPA, WPA_KEY_MGMT_PSK, 1, 1 },
    };
    int i, fail = 0;
    int n = (int) (sizeof(cases) / sizeof(cases[0]));

    printf("--- %s ---", mode); putchar(10);
    for (i = 0; i < n; i++) {
        struct params_stub p; struct drv_stub d; unsigned int got;
        p.wpa_proto = cases[i].proto;
        p.key_mgmt_suite = cases[i].akm;
        d.sae_password_supported = cases[i].sae_pw;
        got = compute_ver(&d, &p);
        printf("  %-34s want=0x%x got=0x%x  %s",
               cases[i].name, cases[i].want, got,
               got == cases[i].want ? "PASS" : "FAIL");
        putchar(10);
        if (got != cases[i].want) fail++;
    }
    return fail ? 1 : 0;
}
