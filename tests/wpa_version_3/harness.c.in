/* GENERATED from harness.c.in by generate.py - do not edit harness.c by hand.
 *
 * The compute_ver() body below is extracted verbatim from
 * src/drivers/driver_nl80211.c so this test tracks the real source.
 *
 * Context: the MediaTek gen4m driver shipped on malachite (mt6878) only
 * decodes nl80211 WPA version bits 0x1 and 0x2. A connect request carrying
 * only NL80211_WPA_VERSION_3 (0x4) falls through to
 * IW_AUTH_WPA_VERSION_DISABLED, the AKM is dropped, and SAE times out with
 * ASSOC-REJECT status_code=16.
 */
#include <stdio.h>

#define BIT(x) (1U << (x))

/* src/common/defs.h */
#define WPA_PROTO_WPA BIT(0)
#define WPA_PROTO_RSN BIT(1)
#define WPA_KEY_MGMT_PSK BIT(1)
#define WPA_KEY_MGMT_SAE BIT(10)
#define WPA_KEY_MGMT_FT_SAE BIT(11)
#define WPA_KEY_MGMT_SAE_EXT_KEY BIT(26)
#define WPA_KEY_MGMT_FT_SAE_EXT_KEY BIT(27)

static inline int wpa_key_mgmt_sae(int akm)
{
    return !!(akm & (WPA_KEY_MGMT_SAE |
                     WPA_KEY_MGMT_SAE_EXT_KEY |
                     WPA_KEY_MGMT_FT_SAE |
                     WPA_KEY_MGMT_FT_SAE_EXT_KEY));
}

/* nl80211 */
enum nl80211_wpa_versions {
    NL80211_WPA_VERSION_1 = 1 << 0,
    NL80211_WPA_VERSION_2 = 1 << 1,
    NL80211_WPA_VERSION_3 = 1 << 2,
};
#define NL80211_ATTR_SAE_PASSWORD 1

